SELECT 
    JSON_UNQUOTE(JSON_EXTRACT(t.elements, '$.account_id')) AS account_id,
    JSON_UNQUOTE(JSON_EXTRACT(t.elements, '$.amount')) AS amount
FROM transactions_json_raw,
JSON_TABLE(doc, '$.transactions[*]' COLUMNS (elements JSON PATH '$')) AS t
JOIN (
    SELECT JSON_UNQUOTE(JSON_EXTRACT(a.elements, '$.account_id')) AS account_id
    FROM accounts_json_raw,
    JSON_TABLE(doc, '$.accounts[*]' COLUMNS (elements JSON PATH '$')) AS a
) AS acc_parsed 
ON JSON_UNQUOTE(JSON_EXTRACT(t.elements, '$.account_id')) = acc_parsed.account_id;

